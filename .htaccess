AuthType Basic
AuthName "Kirkstone Calibration"
# Preserve the existing cPanel-managed password file outside the web root.
AuthUserFile "/home/simpxlow/.htpasswds/quotes.kirkstonecalibration.co.uk/passwd"
Require user Danwalters
Options -Indexes
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"

# Do not cache the owner login bootstrap or its authentication scripts.
<FilesMatch "^(index[.]html|firebase[.]js|app[.]js)$">
  Header always set Cache-Control "no-store, max-age=0"
</FilesMatch>
