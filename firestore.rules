rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/accessControl)
        && get(/databases/$(database)/documents/config/accessControl).data.ownerUid == request.auth.uid;
    }
    function employee() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'employee'
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }
    function safeClaimFields() {
      return request.resource.data.keys().hasOnly([
        'employeeUid','employee','jobId','jobRef','customer','date','from','to',
        'miles','rate','driver','carShare','passengers','purpose','notes',
        'status','submittedAt','submittedByUid','submittedByEmail','approvedBy','approvedAt'
      ]);
    }
    // IMPORTANT: STAGING RULES. Do not deploy before ownerUid and staff
    // records are provisioned, client migration and emulator tests pass.
    match /config/{document} { allow read, write: if owner(); }
    match /quotes/{document} { allow read, write: if owner(); }
    match /jobs/{document} { allow read, write: if owner(); }
    match /customers/{document} { allow read, write: if owner(); }
    match /staff/{uid} { allow read: if owner() || (signedIn() && request.auth.uid == uid); allow write: if owner(); }

    // These documents must be generated by trusted backend code.
    // Employee can read only their own sanitized assigned job projections.
    match /employeeJobs/{document} {
      allow read: if owner() || (employee() && resource.data.assignedUids.hasAny([request.auth.uid]));
      allow write: if false;
    }
    // Calendar projections contain no pricing, costs or quote snapshots.
    match /employeeCalendar/{document} {
      allow read: if owner() || employee();
      allow write: if false;
    }

    match /mileageClaims/{claimId} {
      allow read: if owner() || (employee() && resource.data.employeeUid == request.auth.uid);
      allow create: if employee()
        && safeClaimFields()
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.employee == 'shelley'
        && request.resource.data.driver == 'shelley'
        && request.resource.data.status == 'submitted'
        && request.resource.data.rate == 0.55
        && request.resource.data.miles is number
        && request.resource.data.miles > 0
        && request.resource.data.approvedBy == null
        && request.resource.data.approvedAt == null;
      // Owner approval/adjustment is intentionally through trusted backend only.
      // Prevent employees or owner browsers from forging approval.
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
