rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function access() {
      return get(/databases/$(database)/documents/config/allowedusers).data;
    }
    function role() {
      let email = request.auth.token.email.lower();
      let config = access();
      return config.get('roles', {}).get(email,
        email in config.get('emails', []) ? 'owner' : '');
    }
    function owner() { return verified() && role() == 'owner'; }
    function staff() {
      return verified() && role() == 'staff' && access().get('staffAccessReady', false) == true;
    }
    function activeJob(jobId) {
      return exists(/databases/$(database)/documents/staffJobSheets/$(jobId))
        && get(/databases/$(database)/documents/staffJobSheets/$(jobId)).data.status == 'open';
    }
    function count(value) { return value is int && value >= 0 && value <= 100000; }
    function counts(data) {
      return count(data.singleChannelCount) && count(data.multiChannel6Count)
        && count(data.multiChannel8Count) && count(data.multiChannel12Count)
        && count(data.multiChannel16Count);
    }
    function progressData(data) {
      return data.keys().hasOnly(['uid', 'singleChannelCount', 'multiChannel6Count',
        'multiChannel8Count', 'multiChannel12Count', 'multiChannel16Count'])
        && data.uid == request.auth.uid && counts(data);
    }
    function sameCounts(a, b) {
      return a.uid == b.uid && a.singleChannelCount == b.singleChannelCount
        && a.multiChannel6Count == b.multiChannel6Count
        && a.multiChannel8Count == b.multiChannel8Count
        && a.multiChannel12Count == b.multiChannel12Count
        && a.multiChannel16Count == b.multiChannel16Count;
    }
    function reportData(data, jobId) {
      return data.keys().hasOnly(['uid', 'date', 'serviceLevelId', 'singleChannelCount',
        'multiChannel6Count', 'multiChannel8Count', 'multiChannel12Count',
        'multiChannel16Count', 'expense', 'expenseDescription', 'partsUsed', 'partsQuantity'])
        && data.uid == request.auth.uid && counts(data)
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.serviceLevelId in get(/databases/$(database)/documents/staffJobSheets/$(jobId)).data.serviceLevelIds
        && data.expense is number && data.expense >= 0 && data.expense <= 100000
        && data.expenseDescription is string && data.expenseDescription.size() <= 500
        && data.partsUsed is string && data.partsUsed.size() <= 500
        && count(data.partsQuantity);
    }
    match /config/allowedusers {
      // Only this document is available before a role is resolved.
      allow get: if verified();
      allow write: if owner();
    }
    match /{collection}/{document} {
      // No anonymous access. Only owners can read full jobs, quotes and settings.
      allow read, write: if owner();
    }
    match /staffJobSheets/{jobId} {
      allow read: if staff();
      match /reports/{reportId} {
        allow read: if owner() || (staff() && resource.data.uid == request.auth.uid);
        allow create: if staff() && activeJob(jobId) && reportData(request.resource.data, jobId)
          && sameCounts(request.resource.data,
            getAfter(/databases/$(database)/documents/staffJobSheets/$(jobId)/progress/$(reportId)).data);
        allow update: if staff() && activeJob(jobId) && resource.data.uid == request.auth.uid
          && reportData(request.resource.data, jobId)
          && sameCounts(request.resource.data,
            getAfter(/databases/$(database)/documents/staffJobSheets/$(jobId)/progress/$(reportId)).data);
        allow write: if owner();
      }
      match /progress/{reportId} {
        allow read: if owner() || staff();
        allow create: if staff() && activeJob(jobId) && progressData(request.resource.data)
          && sameCounts(request.resource.data,
            getAfter(/databases/$(database)/documents/staffJobSheets/$(jobId)/reports/$(reportId)).data);
        allow update: if staff() && activeJob(jobId) && resource.data.uid == request.auth.uid
          && progressData(request.resource.data)
          && sameCounts(request.resource.data,
            getAfter(/databases/$(database)/documents/staffJobSheets/$(jobId)/reports/$(reportId)).data);
        allow write: if owner();
      }
    }
  }
}

